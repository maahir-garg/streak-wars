# ---- Telegram ----
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# The chat where daily summaries and streak-break taunts get posted.
# This is usually your group chat id (a negative number).
# Tip: add the bot to the group, send a message, then use /id (works for anyone)
# or check https://api.telegram.org/bot<TOKEN>/getUpdates
GROUP_CHAT_ID=-1001234567890

# ---- Scheduling ----
# Any IANA timezone name, e.g. Asia/Singapore, Asia/Kolkata, Europe/London,
# America/New_York. Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Singapore
# What time the morning summary posts, 24h HH:MM, in TIMEZONE above.
# e.g. 08:00 = 8am, 20:30 = 8:30pm.
DAILY_SUMMARY_TIME=08:00
# How often (in minutes) to check whether someone's streak broke.
STREAK_CHECK_INTERVAL_MINUTES=60

# ---- Users ----
# Numbered 1..N. Each user needs NAME + TELEGRAM_ID, plus one handle per
# platform: USER{n}_{PLATFORM}. Platform names match the registered modules
# (currently only "leetcode" -> USER1_LEETCODE).
# Find your Telegram id by messaging the bot and sending /id.

USER1_NAME=Me
USER1_TELEGRAM_ID=111111111
USER1_LEETCODE=my_leetcode_username

USER2_NAME=Friend
USER2_TELEGRAM_ID=222222222
USER2_LEETCODE=friend_leetcode_username
