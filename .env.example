# Telegram
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# The chat where daily summaries and streak-break announcements are posted,
# usually a group chat id (a negative number). To find it, add @RawDataBot or
# @userinfobot to the group; it reports the chat id. Remove it afterwards.
GROUP_CHAT_ID=

# Scheduling
# Any IANA timezone name, e.g. Asia/Singapore, Europe/London, America/New_York.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Singapore
# When the daily summary is posted, 24h HH:MM, in TIMEZONE above.
DAILY_SUMMARY_TIME=08:00
# How often (in minutes) to check whether a streak broke.
STREAK_CHECK_INTERVAL_MINUTES=60

# Participants
# Numbered 1, 2, 3, ... Add as many as you like; the bot supports any number.
# Each participant needs NAME and TELEGRAM_ID, plus one handle per platform in
# the form USER{n}_{PLATFORM}. Platform names match the registered modules
# (currently "leetcode", so USER1_LEETCODE).
#
# TELEGRAM_ID controls who may issue commands. To find a person's id, have them
# message @userinfobot. It is only needed for command access; tracking a
# participant's streak requires only their platform handle.

USER1_NAME=
USER1_TELEGRAM_ID=
USER1_LEETCODE=

USER2_NAME=
USER2_TELEGRAM_ID=
USER2_LEETCODE=
